{
  "manifest_version": 3,
  "name": "Sahte Haber Dedektifi",
  "version": "1.2.0",
  "description": "Okuduğunuz haberleri yapay zeka ile analiz edin",
  "permissions": ["storage", "activeTab", "tabs", "contextMenus"],
  "host_permissions": ["https://nehaber.dev/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
